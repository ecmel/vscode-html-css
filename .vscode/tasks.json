{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "watch",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^(?:error during build:|✗ .*|\\s+.*is not exported.*)$",
          "message": 0
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "build started\\.\\.\\.",
          "endsPattern": "(built in \\d+ms\\.|error during build:)"
        }
      },
      "presentation": {
        "reveal": "never",
        "group": "watchers"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "label": "npm: watch"
    }
  ]
}
